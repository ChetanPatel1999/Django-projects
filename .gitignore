```gitignore
# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
venv/
env/
.venv/
ENV/

# Django
*.log
db.sqlite3
db.sqlite3-journal

# Environment variables / Secret keys
.env
.env.*

# Media files
media/

# Static files generated by collectstatic
staticfiles/

# IDE / Editor
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Python packaging
*.egg
*.egg-info/
dist/
build/
.eggs/

# Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# mypy
.mypy_cache/

# Pyre
.pyre/
```
